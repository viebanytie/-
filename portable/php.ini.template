[PHP]
extension_dir="{EXT_DIR}"
extension=curl
extension=gd
extension=intl
extension=mbstring
extension=mysqli
extension=openssl
extension=sodium
extension=zip
extension=fileinfo
extension=exif
memory_limit=512M
max_execution_time=300
max_input_time=300
max_input_vars=5000
post_max_size=128M
upload_max_filesize=128M
date.timezone=Europe/Moscow
session.save_path="{SESSION_DIR}"
upload_tmp_dir="{TEMP_DIR}"
sys_temp_dir="{TEMP_DIR}"
log_errors=On
display_errors=Off
error_log="{ERROR_LOG}"
default_charset=UTF-8
allow_url_fopen=Off
cgi.fix_pathinfo=1
